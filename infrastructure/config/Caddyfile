{
	servers {
		metrics
	}
	admin :2019
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# www -> apex, so search engines see one canonical host
www.synci.ch {
	redir https://synci.ch{uri} permanent
}

synci.ch {
	import common
	handle /api* {
		reverse_proxy synci-backend-prod:8080
	}
	handle {
		reverse_proxy synci-frontend-prod:5173
	}
}

# the dev instance serves the same content and must stay out of search results
dev.synci.awild.ch {
	import common
	header X-Robots-Tag "noindex, nofollow"
	handle /api* {
		reverse_proxy synci-backend-dev:8080
	}
	handle {
		reverse_proxy synci-frontend-dev:5173
	}
}

dashboard.synci.awild.ch {
	import common
	header X-Robots-Tag "noindex, nofollow"
	handle {
		reverse_proxy grafana:3000
	}
}
